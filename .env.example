# =============================================================================
# APS 本地开发环境变量模板（P0-06）
# 用法：复制为仓库根目录 .env（scripts/dev-up.* 在缺失时会自动复制）
#   PowerShell : Copy-Item .env.example .env
#   Bash       : cp .env.example .env
# 注意：.env 只用于本地开发，务必不要提交真实密码/密钥。
# =============================================================================

# —— compose 工程名（影响容器名、网络名、数据卷名前缀）——
COMPOSE_PROJECT_NAME=aps-dev

# —— PostgreSQL 15 ——
POSTGRES_DB=aps
POSTGRES_USER=aps
POSTGRES_PASSWORD=aps_dev_pwd

# —— Redis 7（必须非空，后端与健康检查共用此密码）——
REDIS_PASSWORD=redis_dev_pwd

# —— MinIO ——
MINIO_ROOT_USER=apsminio
MINIO_ROOT_PASSWORD=aps_dev_minio_pwd
MINIO_BUCKET=aps-attachments

# —— MinIO 镜像覆盖（可选）——
# 官方社区镜像已从 Docker Hub 下架、quay.io 需授权，默认使用社区维护分支的固定 RELEASE tag。
# 若内网 Harbor 有官方/自建镜像，取消注释并替换：
# MINIO_IMAGE=harbor.example.com/minio/minio:RELEASE.2025-09-07T16-13-09Z

# —— 调试端口 ——
# 仅在叠加 docker-compose.dev.expose.yml（-ExposeDebug / --expose-debug）时生效，
# 且只绑定 127.0.0.1，不对局域网暴露。
POSTGRES_DEBUG_PORT=5432
REDIS_DEBUG_PORT=6379
MINIO_API_DEBUG_PORT=9010
MINIO_CONSOLE_DEBUG_PORT=9011

# =============================================================================
# 以下变量仅供后端读取（由未来的 application-dev.yml 通过 ${...} 占位符对接）
# 本仓库不改 application*.yml，变量名即为双方契约，改名需同步后端配置。
#
# 注意：host 写 localhost 的前提是后端跑在宿主机（IDE）且叠加了 expose 文件；
#       若后端之后也进 compose，应改为 postgres / redis / minio 服务名。
# =============================================================================

# DataSource -> spring.datasource.url / username / password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aps
SPRING_DATASOURCE_USERNAME=aps
SPRING_DATASOURCE_PASSWORD=aps_dev_pwd

# Redis -> Spring Boot 3.2+ 的 spring.data.redis.*
# （若后端仍是 Spring Boot 2.x，请改用 SPRING_REDIS_HOST / SPRING_REDIS_PORT / SPRING_REDIS_PASSWORD）
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=redis_dev_pwd

# MinIO -> aps.storage.minio.endpoint / access-key / secret-key / bucket
APS_MINIO_ENDPOINT=http://localhost:9000
APS_MINIO_ACCESS_KEY=apsminio
APS_MINIO_SECRET_KEY=aps_dev_minio_pwd
APS_MINIO_BUCKET=aps-attachments

# —— 认证与安全（C27 / P0-1）——
# mode 缺省为 prod（安全模式开启）；dev/off 必须显式设置。dev 模式还要求 SPRING profile=dev。
APS_SECURITY_MODE=dev
# JWT -> aps.security.jwt.secret；必须显式配置，至少 32 字节，禁止使用历史公开默认值
APS_SECURITY_JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
APS_SECURITY_JWT_TTL_SECONDS=28800

# dev API Key（仅 dev profile + dev 模式）；留空则禁用 API Key，只接受 JWT。
# 不要使用历史公开值 dev-write-key / dev-read-key。
APS_SECURITY_API_KEYS_WRITE=
APS_SECURITY_API_KEYS_READ=

# WebSocket Origin 白名单（P1-4），逗号分隔；默认仅本地前端
APS_SECURITY_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:18091,http://127.0.0.1:18091

# —— LLM（V05-01 / C45 现场演示，可选）——
# 优先级：环境变量 > application.yml 同名配置项 > 缺省；全部留空 = 关闭（provider=none），不影响启动。
# provider 取值：deepseek | qwen | ollama | none
# Ollama 为原生 base（如 http://127.0.0.1:11434），API_KEY 可留空；DeepSeek/Qwen 为 OpenAI 兼容 base。
# 本地填入，不得提交真实密钥。
APS_AGENT_LLM_PROVIDER=
APS_AGENT_LLM_BASE_URL=
APS_AGENT_LLM_API_KEY=
APS_AGENT_LLM_MODEL=
APS_AGENT_LLM_TIMEOUT_SECONDS=
