<?xml version="1.0" encoding="UTF-8"?>
<!--
  衡策 APS 日志配置（P0-07）
  - dev / 默认：控制台单行日志，人类可读，含 traceId、tenantId、耗时
  - prod：控制台 JSON（LogstashEncoder），可直接被 Loki / ELK 采集
  说明：容器环境统一输出到 stdout，由平台侧收集，不落本地滚动文件。
-->
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="aps-admin"/>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [traceId=%X{traceId:-}] [tenantId=%X{tenantId:-}] %logger{40} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${APP_NAME}","env":"prod"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>tenantId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>durationMs</includeMdcKeyName>
                <includeCallerData>false</includeCallerData>
                <stackTraceElementFilter>RUNTIME</stackTraceElementFilter>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
