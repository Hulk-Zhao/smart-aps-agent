# 开发环境：后端通过 Vite 代理或网关转发 /api/v1
VITE_API_BASE_URL=/api/v1
# 契约 Mock 默认关闭；需要离线联调时改为 true（或在 .env.development.local 覆盖）
VITE_ENABLE_MOCK=false
VITE_MOCK_DELAY=300
# 开发态写请求鉴权（C27）：vite.config.ts 的 /api 代理会把它注入为 X-API-Key。
# 值只能写在 .env.development.local（*local 不入库），禁止在本文件写死密钥。
# 风险：该密钥仅用于本机开发联调；生产不经过 Vite 代理，由网关或 JWT 鉴权，不会带此头。
# APS_DEV_API_KEY=
