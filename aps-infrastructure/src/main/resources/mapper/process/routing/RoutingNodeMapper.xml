<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hengce.aps.infrastructure.persistence.mapper.process.routing.RoutingNodeMapper">

    <resultMap id="routingNodeResultMap"
               type="com.hengce.aps.infrastructure.persistence.process.routing.RoutingNode">
        <id property="id" column="id"
            typeHandler="com.hengce.aps.infrastructure.persistence.process.template.handler.UuidTypeHandler"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="routingId" column="routing_id"/>
        <result property="nodeKey" column="node_key"/>
        <result property="operationTemplateId" column="operation_template_id"/>
        <result property="operationCode" column="operation_code"/>
        <result property="operationName" column="operation_name"/>
        <result property="standardSeconds" column="standard_seconds"/>
        <result property="setupSeconds" column="setup_seconds"/>
        <result property="teardownSeconds" column="teardown_seconds"/>
        <result property="isOptional" column="is_optional"/>
        <result property="overrides" column="overrides"
                typeHandler="com.hengce.aps.infrastructure.persistence.handler.JsonbTypeHandler"/>
        <result property="positionX" column="position_x"/>
        <result property="positionY" column="position_y"/>
        <result property="seqNo" column="seq_no"/>
        <result property="version" column="version"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <sql id="baseColumns">
        id, tenant_id, routing_id, node_key, operation_template_id, operation_code, operation_name,
        standard_seconds, setup_seconds, teardown_seconds, is_optional, overrides,
        position_x, position_y, seq_no, version, created_at, updated_at, created_by, updated_by, deleted
    </sql>

    <select id="selectByRoutingId" resultMap="routingNodeResultMap">
        SELECT <include refid="baseColumns"/>
        FROM routing_node
        WHERE routing_id = #{routingId}
          AND deleted = false
        ORDER BY seq_no ASC, node_key ASC
    </select>

    <insert id="insert" parameterType="com.hengce.aps.infrastructure.persistence.process.routing.RoutingNode">
        INSERT INTO routing_node (
            <include refid="baseColumns"/>
        ) VALUES (
            #{id}, #{tenantId}, #{routingId}, #{nodeKey}, #{operationTemplateId}, #{operationCode},
            #{operationName}, #{standardSeconds}, #{setupSeconds}, #{teardownSeconds}, #{isOptional},
            #{overrides,typeHandler=com.hengce.aps.infrastructure.persistence.handler.JsonbTypeHandler},
            #{positionX}, #{positionY}, #{seqNo}, #{version}, #{createdAt}, #{updatedAt},
            #{createdBy}, #{updatedBy}, #{deleted}
        )
    </insert>

    <update id="update" parameterType="com.hengce.aps.infrastructure.persistence.process.routing.RoutingNode">
        UPDATE routing_node
        SET operation_template_id = #{operationTemplateId},
            operation_code = #{operationCode},
            operation_name = #{operationName},
            standard_seconds = #{standardSeconds},
            setup_seconds = #{setupSeconds},
            teardown_seconds = #{teardownSeconds},
            is_optional = #{isOptional},
            overrides = #{overrides,typeHandler=com.hengce.aps.infrastructure.persistence.handler.JsonbTypeHandler},
            position_x = #{positionX},
            position_y = #{positionY},
            seq_no = #{seqNo},
            version = version + 1,
            updated_at = #{updatedAt},
            updated_by = #{updatedBy}
        WHERE id = #{id}
          AND deleted = false
    </update>

    <update id="deleteById">
        UPDATE routing_node
        SET deleted = true,
            updated_at = now()
        WHERE id = #{id}
          AND deleted = false
    </update>

    <update id="deleteByRoutingId">
        UPDATE routing_node
        SET deleted = true,
            updated_at = now()
        WHERE routing_id = #{routingId}
          AND deleted = false
    </update>
</mapper>
