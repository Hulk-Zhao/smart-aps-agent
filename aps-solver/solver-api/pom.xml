<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hengce.aps</groupId>
        <artifactId>aps-solver</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>solver-api</artifactId>
    <name>solver-api</name>
    <description>求解器统一抽象，禁止依赖任何具体引擎</description>

    <dependencies>
        <dependency>
            <groupId>com.hengce.aps</groupId>
            <artifactId>aps-common</artifactId>
        </dependency>
        <!-- C20 §8.3：SolveProgress/SolveTaskDetail 使用 @JsonInclude 保证字段恒输出（null 亦输出） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 序列化单测：验证 metrics 内 null 值不被全局 non_null 抑制（C20 §24.2） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
